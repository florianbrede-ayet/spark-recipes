# ---------------------------------------------------------------------------
# Cluster topology for this recipe. Copy to config/cluster.env and adjust.
#
#   cp config/cluster.env.example config/cluster.env
#
# Contains no secrets. config/cluster.env is intentionally NOT tracked by
# SHA256SUMS because it is site-local.
# ---------------------------------------------------------------------------

# Management addresses (SSH / operator access). Live values from the audit.
# These alone identify the node for network bootstrap, which by definition runs
# before the fabric exists.
PRIMARY_MGMT_IP="192.168.1.151"
WORKER_MGMT_IP="192.168.1.152"
MGMT_IFACE="enP7s7"

# Optional hostname fallback for role detection, used only when neither
# management address is up yet. Left empty on purpose: the audited hostnames are
# raw machine identifiers and are deliberately not carried in this bundle. Fill
# these in locally if you need the fallback. Both must be set and must differ,
# or the mapping is ignored rather than trusted.
PRIMARY_HOSTNAME=""
WORKER_HOSTNAME=""

# Cluster fabric: rail A. This is the rail the live job uses for NCCL, Gloo,
# the torch.distributed rendezvous and VLLM_HOST_IP.
FABRIC_ETH_IF="enp1s0f0np0"
FABRIC_IB_IF="rocep1s0f0"
PRIMARY_FABRIC_IP="10.0.7.1"
WORKER_FABRIC_IP="10.0.7.2"
FABRIC_SUBNET="10.0.7.0/30"
FABRIC_MTU="9000"
FABRIC_NM_PROFILE="cx7-port0-a"
# Audited route metric for rail A. Lower wins; rail B is deliberately lower
# still, so neither rail can shadow the other by accident.
FABRIC_ROUTE_METRIC="101"

# Cluster fabric: rail B (twin, cabled and ACTIVE, NOT used by this job).
# It MUST stay on its own subnet, distinct from rail A. See docs/01-network.md.
FABRIC_B_ETH_IF="enP2p1s0f0np0"
FABRIC_B_IB_IF="roceP2p1s0f0"
PRIMARY_FABRIC_B_IP="10.0.7.5"
WORKER_FABRIC_B_IP="10.0.7.6"
FABRIC_B_SUBNET="10.0.7.4/30"
FABRIC_B_MTU="9000"
FABRIC_B_NM_PROFILE="cx7-port0-b"
FABRIC_B_ROUTE_METRIC="100"

# Rendezvous. The master address is the PRIMARY's rail-A address.
MASTER_ADDR="10.0.7.1"
MASTER_PORT="29501"

# Container / API.
CONTAINER_NAME="vllm_node"
API_HOST="0.0.0.0"
API_PORT="8888"

# Host-side cache roots that get bind-mounted into the container.
# The live deployment ran as an unprivileged user in the `docker` group and
# used that user's $HOME. Leave as $HOME unless you know you need otherwise.
CACHE_ROOT="${HOME}"

# SSH target used to reach the worker for coordinated start/stop. Must be a
# key-based, non-interactive login. Never put a password here.
WORKER_SSH_TARGET="192.168.1.152"
