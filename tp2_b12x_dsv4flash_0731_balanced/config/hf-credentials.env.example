# ---------------------------------------------------------------------------
# Hugging Face credentials for acquiring the gated model.
#
#   cp config/hf-credentials.env.example config/hf-credentials.env
#   chmod 600 config/hf-credentials.env
#   # then replace the placeholder below with your own token
#
# THIS REPOSITORY CONTAINS NO REAL CREDENTIALS AND MUST NEVER CONTAIN ANY.
# config/hf-credentials.env is deliberately excluded from SHA256SUMS and from
# version control. scripts/validate.sh fails if a token-shaped string is ever
# committed anywhere in this tree.
#
# The placeholder value below is the literal string in angle brackets. Scripts
# treat any value that still starts with "<" as unset and refuse to use it.
# ---------------------------------------------------------------------------

# Read token with access to the gated repo deepseek-ai/DeepSeek-V4-Flash-0731.
HF_TOKEN="<PUT-YOUR-HUGGINGFACE-READ-TOKEN-HERE>"

# Optional: point the HF cache somewhere with enough free space.
# The live deployment used the default ${HOME}/.cache/huggingface.
HF_HOME="${HOME}/.cache/huggingface"

# Optional registry credentials, if your mirror of the B12X image needs auth.
# Prefer `docker login` on the host over storing anything here.
REGISTRY_USERNAME="<OPTIONAL-REGISTRY-USERNAME>"
REGISTRY_PASSWORD="<OPTIONAL-REGISTRY-PASSWORD>"
