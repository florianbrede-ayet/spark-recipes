+# Spill tier (patch 0084-glm-spill-tier, off by default): kept prompt states go to local disk on each Spark and come
+# back instead of a new prefill, also after a clean restart. SPILL_GIB: the cap per Spark (0: off). SPILL_DIR: the same
+# absolute path on every Spark (mounted at /spill; files owned by your user). SPILL_HIGHWATER: past this fraction of
+# the KV pool, the kept prompts eviction would take next are written in the background (1.0: only when evicted).
+# A clean stop writes what is kept within SPILL_FLUSH_S seconds; STOP_TIMEOUT gives it the time. README: Spill tier.
+SPILL_GIB="${SPILL_GIB:-0}"
+SPILL_DIR="${SPILL_DIR:-$HOME/.cache/tensorfold-spill}"
+SPILL_HIGHWATER="${SPILL_HIGHWATER:-0.70}"
+SPILL_MIN_TOKENS="${SPILL_MIN_TOKENS:-8192}"
+SPILL_MIN_FREE_GIB="${SPILL_MIN_FREE_GIB:-50}"
+SPILL_FLUSH_S="${SPILL_FLUSH_S:-60}"
+STOP_TIMEOUT_EXPLICIT=${STOP_TIMEOUT+1}        # set by you (environment, scripts/local.sh, .env): never overridden
+if [[ "$SPILL_GIB" != 0 ]]; then
+  STOP_TIMEOUT="${STOP_TIMEOUT:-$(( ${SPILL_FLUSH_S%.*} + 30 ))}"
+fi
+
+# The seconds a stop should allow, read from the container that is actually running rather than from these settings:
+# an ephemeral `SPILL_GIB=64 ./start.sh` leaves a container whose flush needs SPILL_FLUSH_S, and a later plain
+# `./stop.sh` sees SPILL_GIB=0 here and would cut the flush off at 30 s. Read-only (docker inspect), rank 0's
+# container here, and only ever raises the value: an explicit STOP_TIMEOUT wins, and so does a larger configured one.
+# No container (or none here): the configured value stands.
+spill_stop_timeout() {
+  local base="${STOP_TIMEOUT:-30}" words gib=0 flush prev="" w need
+  [[ -n "${STOP_TIMEOUT_EXPLICIT:-}" ]] && { echo "$base"; return 0; }
+  words=$(docker inspect -f '{{range .Config.Cmd}}{{println .}}{{end}}' "$CONTAINER_NAME" 2>/dev/null) ||
+    { echo "$base"; return 0; }
+  while IFS= read -r w; do                     # the effective --spill-gib (its last occurrence, either form)
+    case "$w" in
+      --spill-gib=*) gib="${w#*=}" ;;
+      *) [[ "$prev" == --spill-gib ]] && gib="$w" ;;
+    esac
+    prev="$w"
+  done <<<"$words"
