--- /dev/null
+++ b/tools/spill_tier_check.py
@@ -0,0 +1,485 @@
+#!/usr/bin/env python3
+"""Checks for patch 0084 (the spill tier, SPILL_GIB), run inside the image that scripts/prepare.sh built:
+
+    docker run --rm --entrypoint python -v "$PWD/tools/spill_tier_check.py:/c.py" tensorfold-glm53:v0.6.0 /c.py
+
+No GPU, no server, no model: CPU tensors, a temporary directory, and the real cuda/spill.py and the real
+GlmEngine._take_over. Upstream PR #78 ships no test file, so these cover what this recipe's port has to keep right:
+
+  store      the file format and its header, a round-trip of a kept state's fields and rows, the CRC-32 over every
+             8 MiB block (a flipped byte, a truncated file), the index's cap and recency, find/has over prefixes and
+             the token grid, and the compatibility hash (another build's files are not read).
+  ranks      with world > 1 every rank writes or skips alike: the size and the free-disk floor are agreed in one
+             all-gather, and a rank that cannot use its directory stops every rank.
+  spanned    patch 0072's display span: rows a memcpy may not cross (spanned=) go through the bitwise_or kernel both
+             ways, and the file is byte-identical to the one the memcpy path writes.
+  take_over  the merge of 0078 (decided first, copied after) with this patch: every drop happens before any
+             save_rows, each survivor's write follows its own save_rows with the DFlash2 window it had, every pending
+             copy is waited for before the pool is given rows back, and empty_cache follows over_budget (0078's
+             NV_ERR_NO_MEMORY fix), not the old dropped flag.
+
+Exit code 1 when a check fails.
+"""
+import json
+import os
+import shutil
+import struct
+import sys
+import tempfile
+
+import numpy as np
+import torch
+
+from tensorfold.cuda import spill as sp
+
+failures = []
+
+
+def check(name, ok, detail=""):
+    print(("ok   " if ok else "FAIL ") + name + (f" ({detail})" if detail and not ok else ""))
+    if not ok:
+        failures.append(name)
+
+
+def raises(name, fn, kinds=Exception, detail=""):
+    try:
+        fn()
+    except kinds as exc:
+        check(name, True)
+        return exc
+    except Exception as exc:                 # noqa: BLE001  (the wrong kind is the failure)
+        check(name, False, f"{type(exc).__name__}: {exc}")
+        return exc
+    check(name, False, detail or "no error raised")
+    return None
+
+
+# -- a kept state to store, standing in for decode.Snapshot -------------------------------------------------------------
+class Kept:
+    """The fields ``encode`` walks: tensors go to the file, the rest rides in the layer. ``_SPILL_SKIP``'s names are
+    left out by the caller, as the engine leaves out ids, keys and extents."""
+
+    def __init__(self, n=64, seed=0):
+        g = torch.Generator().manual_seed(seed)
+        self.ids = list(range(n))                      # skipped: the header's tokens hold them
+        self.rec = torch.randn(4, 8, generator=g)
+        self.conv = torch.randn(2, 16, generator=g)
+        self.pending = None
+        self.head = None
+        self.tail = None
+        self.rows = None
+        self.nbytes = 0
+        self.drafter_rows = None
+        self.drafter_end = -1
+        self.mtp_len = -1
+        self.policy = [1, 2, 3]
+        self.cached = 7
+        self.prompt_tokens = n
+
+
+SKIP = ("ids", "ids_array", "nbytes", "key", "kid", "extent", "images", "shared")
+CLASSES = (f"{Kept.__module__}:Kept",)
+
+
+def store(root, *, gib=1.0, min_tokens=4, min_free_gib=0.0, world=1, rank=0, gather=None,
+          signature="sig", spanned=(), quiet=True, writers=1):
+    cfg = sp.SpillConfig(root=root, gib=gib, highwater=0.7, min_tokens=min_tokens, min_free_gib=min_free_gib,
+                         keep_builds=1, writers=writers, direct=False, flush_s=5.0)
+    return sp.SpillStore(cfg, rank=rank, world=world, device="cpu", signature=signature, model_id="check",
+                         classes=CLASSES, spanned=spanned, quiet=quiet, gather=gather,
+                         weights=f"weights-rank{rank}")
+
+
+def put(st, kept, rows=(), **kw):
+    """Save and wait for the write to land."""
+    job = st.save(kept.ids, kept, rows, skip=SKIP, **kw)
+    if job is not None:
+        st.release(job)
+        st.drain(10.0)
+    return job
+
+
+def ids(n, base=0):
+    return list(range(base, base + n))
+
+
+# ====================================================================================================== store
+def store_checks(tmp):
+    root = os.path.join(tmp, "store")
+    os.makedirs(root)
+    st = store(root)
+
+    k = Kept(64, seed=1)
+    rows = [("p0", torch.arange(1024, dtype=torch.uint8).repeat(3)),
+            ("p1", torch.randn(16, 8))]
+    job = put(st, k, rows)
+    check("store: a save queues a job", job is not None)
+    check("store: the write landed", st.stats.written == 1 and st.stats.write_failed == 0,
+          f"written={st.stats.written} failed={st.stats.write_failed}")
+    key = sp.ids_key(k.ids)
+    check("store: has() finds it by its ids", st.has(k.ids) and st.has(k.ids, key))
+
+    path = os.path.join(st.dir, st.index[key].name + ".safetensors")
+    check("store: one 0600 file per prompt", os.path.isfile(path) and (os.stat(path).st_mode & 0o777) == 0o600,
+          oct(os.stat(path).st_mode & 0o777))
+    with open(path, "rb") as f:
+        header, data_at = sp._read_header_file(f)
+    meta = header["__metadata__"]
+    check("store: the header names the format and the build", meta["format"] == sp.FORMAT and meta["compat"] == st.compat)
+    check("store: the header holds the prompt's tokens", json.loads(meta["tokens"]) == k.ids)
+    check("store: the header's size matches the file", os.path.getsize(path) == data_at + sum(
+        d["data_offsets"][1] - d["data_offsets"][0] for n, d in header.items() if n != "__metadata__"))
+    blocks = -(-(os.path.getsize(path) - data_at) // sp.BLOCK)
+    check("store: a CRC-32 per 8 MiB block", len(meta["crc32"].split(",")) == max(1, blocks),
+          f"{len(meta['crc32'].split(','))} crcs for {blocks} blocks")
+
+    got, back, m2 = st.load(key)
+    check("store: the round-trip rebuilds the class", type(got).__name__ == "Kept")
+    check("store: its tensor fields come back equal",
+          torch.equal(got.rec, k.rec) and torch.equal(got.conv, k.conv))
+    check("store: its plain fields come back equal", got.policy == k.policy and got.cached == k.cached)
+    check("store: the named rows come back equal",
+          set(back) == {"p0", "p1"} and all(torch.equal(back[n], t) for n, t in rows))
+    check("store: a skipped field is not stored", getattr(got, "nbytes", 0) == 0 and int(m2["n"]) == len(k.ids))
+    check("store: the restore is counted", st.stats.loaded == 1 and st.stats.load_failed == 0)
+
+    # find(): a prefix of a longer prompt, and the token grid
+    check("store: find() matches a longer prompt that extends it", st.find(ids(96)) is not None)
+    check("store: find() matches the prompt itself only with its head",
+          st.find(ids(64)) is None and st.find(ids(64), whole_needs_head=False) is not None)
+    check("store: find() does not match a different prompt", st.find(ids(96, base=5)) is None)
+    check("store: find() keeps prompt chunks on the grid", st.find(ids(96), grid=48) is None
+          and st.find(ids(96), grid=32) is not None)
+
+    # a flipped data byte: the CRC catches it, every rank forgets the entry
+    with open(path, "r+b") as f:
+        f.seek(data_at + 3)
+        b = f.read(1)
+        f.seek(data_at + 3)
+        f.write(bytes([b[0] ^ 0x40]))
+    before = st.stats.crc_failed
+    raises("store: a flipped data byte fails the read", lambda: st.load(key))
+    check("store: the flip is counted as a CRC failure", st.stats.crc_failed == before + 1,
+          f"crc_failed {before} -> {st.stats.crc_failed}")
+    st.forget(key)
+    check("store: a failed entry is forgotten", not st.has(k.ids))
+
+    # a truncated file is dropped by the scan at the next start
+    k2 = Kept(72, seed=2)
+    put(st, k2)
+    p2 = os.path.join(st.dir, st.index[sp.ids_key(k2.ids)].name + ".safetensors")
+    with open(p2, "r+b") as f:
+        f.truncate(os.path.getsize(p2) - 64)
+    again = store(root)
+    check("store: a truncated file is dropped at the next start", not again.has(k2.ids),
+          f"index={len(again.index)}")
+
+    # the index's cap evicts the least recently used: the cap is measured, not guessed, so two entries fit and
+    # the third pushes the oldest out
+    big = [("p0", torch.zeros(24 * 1024, dtype=torch.uint8))]
+    gauge = store(os.path.join(tmp, "gauge"), gib=4.0)
+    put(gauge, Kept(64, seed=99), big)
+    one = gauge.index[sp.ids_key(ids(64))].size
+    small = store(os.path.join(tmp, "cap"), gib=(one * 2.4) / (1 << 30))
+    kept = [Kept(64 + i, seed=10 + i) for i in range(3)]
+    for kk in kept:
+        put(small, kk, big)
+    check("store: three entries of a two-entry cap leave two", len(small.index) == 2,
+          f"{len(small.index)} entries, cap {small.cap} B, entry ~{one} B")
+    check("store: the cap holds and nothing is over it", small._total() <= small.cap,
+          f"{small._total()} > {small.cap}")
+    check("store: the least recently used file went first, the newest stayed",
+          small.has(kept[-1].ids) and not small.has(kept[0].ids),
+          f"has={[small.has(x.ids) for x in kept]}")
+    check("store: the evicted file is gone from disk",
+          len([f for f in os.listdir(small.dir) if f.endswith(".safetensors")]) == 2,
+          str(sorted(os.listdir(small.dir))))
+    check("store: evictions are not write failures", small.stats.write_failed == 0)
+    check("store: info() reports the tier", small.info()["entries"] == len(small.index)
+          and "restore_ms_p50" in small.info())
+
+    # another build's files are never read
+    other = store(root, signature="another-build")
+    check("ranks: another build gets its own directory", other.top != st.top)
+    check("ranks: another build's stored prompts are not read", not other.has(k.ids))
+    return st
+
+
+# ====================================================================================================== ranks
+def rank_checks(tmp):
+    root = os.path.join(tmp, "ranks")
+    os.makedirs(root)
+
+    # one all-gather agrees the size and the floor; a rank below the floor stops every write
+    def gather_ok(words):
+        return [list(words), list(words)]
+
+    st = store(root, world=2, gather=gather_ok, min_free_gib=0.0)
+    k = Kept(64, seed=3)
+    check("ranks: both ranks agree and the save goes", put(st, k) is not None)
+    check("ranks: the directory is this rank's", st.dir.endswith("rank0") and st.compat in st.top)
+
+    def gather_no_space(words):
+        return [list(words), [0] + list(words[1:])]      # the other rank is under its floor
+
+    st2 = store(os.path.join(tmp, "ranks2"), world=2, gather=gather_no_space)
+    k2 = Kept(68, seed=4)
+    check("ranks: no rank writes when one is under the free-disk floor", put(st2, k2) is None)
+    check("ranks: that is counted as no_space, not a failure",
+          st2.stats.no_space == 1 and st2.stats.write_failed == 0)
+
+    # the agreed size is the largest rank's
+    seen = {}
+
+    def gather_big(words):
+        if len(words) == 2:
+            seen["asked"] = words[1]
+            return [list(words), [1, words[1] * 4]]
+        return [list(words), list(words)]
+
+    st3 = store(os.path.join(tmp, "ranks3"), world=2, gather=gather_big, gib=0.0001)
+    raised = put(st3, Kept(64, seed=5), [("p0", torch.zeros(64 * 1024, dtype=torch.uint8))])
+    check("ranks: a size no rank can fit is refused on every rank", raised is None and st3.stats.full == 1,
+          f"job={raised} full={st3.stats.full}")
+
+    # a rank that cannot use its directory stops every rank
+    def gather_bad_dir(words):
+        return [list(words), [1] + list(words[1:])] if len(words) == 1 else [list(words), list(words)]
+
+    raises("ranks: a rank that cannot use its directory stops every rank",
+           lambda: store(os.path.join(tmp, "ranks4"), world=2, gather=gather_bad_dir), RuntimeError)
+    return st
+
+
+# ====================================================================================================== spanned
+def spanned_checks(tmp):
+    """Patch 0072's display span: rows a memcpy may not cross go through the bitwise_or kernel. On the CPU both paths
+    are memory copies, so the check is that the kernel path writes and reads the same bytes."""
+
+    g = torch.Generator().manual_seed(7)
+    rows = [("p0", (torch.rand(sp.BLOCK + 4096, generator=g) * 255).to(torch.uint8)),   # over one CRC block
+            ("p1", torch.randn(64, 32, generator=g))]
+
+    files = {}
+    for tag, names in (("memcpy", ()), ("kernel", ("p0", "p1"))):
+        root = os.path.join(tmp, f"span-{tag}")
+        os.makedirs(root)
+        st = store(root, spanned=names, gib=2.0)
+        k = Kept(64, seed=8)
+        job = put(st, k, rows)
+        check(f"spanned: the {tag} path writes", job is not None and st.stats.write_failed == 0,
+              f"failed={st.stats.write_failed}")
+        key = sp.ids_key(k.ids)
+        _, back, _ = st.load(key)
+        check(f"spanned: the {tag} path reads the rows back equal",
+              all(torch.equal(back[n], t) for n, t in rows))
+        path = os.path.join(st.dir, st.index[key].name + ".safetensors")
+        with open(path, "rb") as f:
+            raw = f.read()
+        with open(path, "rb") as f:
+            header, data_at = sp._read_header_file(f)
+        meta = dict(header["__metadata__"])
+        meta.pop("saved", None)                  # the wall clock of the write differs between the two runs
+        files[tag] = (raw[data_at:], {k: v for k, v in header.items() if k != "__metadata__"}, meta, data_at)
+        check(f"spanned: the store took the {tag} names", st.spanned == frozenset(f"rows.{n}" for n in names))
+
+    mc, kn = files["memcpy"], files["kernel"]
+    check("spanned: the kernel path writes the same bytes as the memcpy path", mc[0] == kn[0],
+          f"{len(mc[0])} vs {len(kn[0])} data bytes")
+    check("spanned: with the same header, CRCs included", mc[1] == kn[1] and mc[2] == kn[2],
+          "tensor table or metadata differ")
+    check("spanned: the payload spans several CRC blocks (the kernel ran per block)",
+          len(kn[0]) > sp.BLOCK, f"{len(kn[0])} data bytes, block {sp.BLOCK}")
+
+    # _by_kernel itself, against a plain copy, over more than one staging buffer
+    src = (torch.rand(sp.STAGE // 4 + 777, generator=g) * 255).to(torch.uint8)
+    dst, ref = torch.zeros_like(src), src.clone()
+    sp._by_kernel(dst, src, sp._stage("cpu", None), None)
+    check("spanned: _by_kernel copies the same bytes as a memcpy", torch.equal(dst, ref))
+    check("spanned: _by_kernel's staging buffer is one block", sp._stage("cpu", None).numel() == sp.STAGE)
+
+
+# ====================================================================================================== take_over
+class Snap:
+    """A kept snapshot ``_take_over`` walks."""
+
+    def __init__(self, tokens, size, need, window=None, rows=None):
+        self.ids = list(tokens)
+        self._size = size
+        self._need = need
+        self.drafter_rows = window
+        self.drafter_end = len(self.ids) if window is not None else -1
+        self.rows = rows
+
+    def __repr__(self):
+        return f"Snap(n={len(self.ids)})"
+
+
+class FakeEngine:
+    """``self`` for the real GlmEngine._take_over: the pool moves and the tier's two calls are logged in order."""
+
+    def __init__(self, snaps, live, cache_bytes, spill=True, drafter=None):
+        self.cache = list(snaps)
+        self.live = list(live)
+        self.cache_bytes = cache_bytes
+        self.spill = object() if spill else None
+        self.e = self                            # _take_over only passes self.e through to the row helpers
+        self.drafter = drafter
+        self.shared = drafter is not None
+        self.log = []
+
+    # the engine's own helpers _take_over leans on
+    def _kept_drafter(self):
+        return self.drafter if self.shared else None
+
+    def _drop(self, snap):
+        self.log.append(("drop", snap))
+        if snap in self.cache:
+            self.cache.remove(snap)
+
+    def _spill_snap(self, snap, leaving=False, keep=frozenset()):
+        self.log.append(("spill_snap", snap, snap.drafter_rows, snap.drafter_end))
+
+    def _spill_wait(self):
+        self.log.append(("spill_wait", None))
+
+    def kinds(self):
+        return [e[0] for e in self.log]
+
+
+def take_over_checks():
+    from tensorfold.families.glm5_next.cuda import decode as D
+    from tensorfold.families.glm5_next.cuda.engine import GlmEngine
+
+    saved_fns = (D.row_bytes, D.save_rows, D.snapshot_bytes)
+    log = []
+
+    def row_bytes(e, snap, drafter=None):
+        return snap._need
+
+    def snapshot_bytes(snap):
+        return snap._size
+
+    def save_rows(e, snap, drafter=None):
+        e.log.append(("save_rows", snap))
+        snap.rows = ["saved"]
+        if drafter is None or snap.drafter_end != len(snap.ids):
+            snap.drafter_end = -1                  # the DFlash2 window no longer fits: this patch writes it now
+            snap.drafter_rows = None
+
+    D.row_bytes, D.save_rows, D.snapshot_bytes = row_bytes, save_rows, snapshot_bytes
+    empty = torch.cuda.empty_cache
+    try:
+        # --- every drop runs before any save_rows, and the wait is last ------------------------------------------
+        live = ids(400)
+        a, b, c = Snap(ids(100), 100, 100), Snap(ids(200), 100, 100), Snap(ids(300), 100, 100)
+        e = FakeEngine([a, b, c], live, cache_bytes=250)
+        torch.cuda.empty_cache = lambda: e.log.append(("empty_cache", None))
+        GlmEngine._take_over(e, ids(400, base=9000))          # a new conversation: nothing resumes
+
+        kinds = e.kinds()
+        drops = [i for i, x in enumerate(kinds) if x == "drop"]
+        saves = [i for i, x in enumerate(kinds) if x == "save_rows"]
+        check("take_over: the budget forced a drop and a copy", bool(drops) and bool(saves), str(kinds))
+        check("take_over: 0078's order holds, every drop before any save_rows",
+              not drops or not saves or max(drops) < min(saves), str(kinds))
+        check("take_over: no snapshot is both dropped and copied",
+              not ({s for k, s, *_ in e.log if k == "drop"} & {s for k, s, *_ in e.log if k == "save_rows"}))
+        check("take_over: pending copies are waited for before the pool is given rows back",
+              "spill_wait" in kinds and ("empty_cache" not in kinds
+                                         or kinds.index("spill_wait") < kinds.index("empty_cache")), str(kinds))
+        check("take_over: the wait follows the last copy", "spill_wait" in kinds
+              and (not saves or kinds.index("spill_wait") > max(saves)), str(kinds))
+        check("take_over: a drop over the budget gives the rows back (0078's NV_ERR fix)",
+              "empty_cache" in kinds, str(kinds))
+
+        # --- nothing dropped for the budget: no empty_cache (0078's over_budget, not the old dropped flag) ------
+        a2 = Snap(ids(100), 10, 10)
+        e2 = FakeEngine([a2], live, cache_bytes=10_000)
+        torch.cuda.empty_cache = lambda: e2.log.append(("empty_cache", None))
+        GlmEngine._take_over(e2, ids(400, base=9000))
+        check("take_over: a copy that fits the budget does not empty the pool",
+              "empty_cache" not in e2.kinds() and "save_rows" in e2.kinds(), str(e2.kinds()))
+
+        # --- rows already gone: dropped, and that alone does not empty the pool ---------------------------------
+        gone = Snap(ids(100, base=7), 10, 10)                 # live[:100] != its ids
+        e3 = FakeEngine([gone], live, cache_bytes=10_000)
+        torch.cuda.empty_cache = lambda: e3.log.append(("empty_cache", None))
+        GlmEngine._take_over(e3, ids(400, base=9000))
+        check("take_over: a snapshot whose rows are gone is dropped without a copy",
+              e3.kinds().count("drop") == 1 and "save_rows" not in e3.kinds(), str(e3.kinds()))
+        check("take_over: a drop for missing rows is not over_budget",
+              "empty_cache" not in e3.kinds(), str(e3.kinds()))
+
+        # --- a survivor whose DFlash2 window save_rows drops is written, with the window it had ------------------
+        drafter = type("D", (), {"ring": 0})()
+        win_rows = [torch.zeros(4), torch.zeros(2)]        # 0078's shed accounting measures these
+        win = Snap(ids(100), 100, 100, window=win_rows)
+        e4 = FakeEngine([win], live, cache_bytes=10_000, drafter=None)   # shared off -> _kept_drafter() is None
+        torch.cuda.empty_cache = lambda: e4.log.append(("empty_cache", None))
+        GlmEngine._take_over(e4, ids(400, base=9000))
+        kinds4 = e4.kinds()
+        check("take_over: its write follows its own save_rows",
+              kinds4.count("save_rows") == 1 and kinds4.count("spill_snap") == 1
+              and kinds4.index("spill_snap") == kinds4.index("save_rows") + 1, str(kinds4))
+        entry = next(x for x in e4.log if x[0] == "spill_snap")
+        check("take_over: the write sees the DFlash2 window the snapshot had",
+              entry[2] is win_rows and entry[3] == 100, f"window={entry[2]} end={entry[3]}")
+        check("take_over: the window is cleared again afterwards",
+              win.drafter_rows is None and win.drafter_end == -1,
+              f"rows={win.drafter_rows} end={win.drafter_end}")
+        check("take_over: the wait still runs after the write",
+              kinds4.index("spill_wait") > kinds4.index("spill_snap"), str(kinds4))
+
+        # --- a survivor whose window survives is not written here -----------------------------------------------
+        keepwin = Snap(ids(100), 100, 100, window=[torch.zeros(4)])
+        e5 = FakeEngine([keepwin], live, cache_bytes=10_000, drafter=drafter)   # shared on, window at the end: kept
+        torch.cuda.empty_cache = lambda: e5.log.append(("empty_cache", None))
+        GlmEngine._take_over(e5, ids(400, base=9000))
+        check("take_over: a snapshot whose window save_rows keeps is not written here",
+              "save_rows" in e5.kinds() and "spill_snap" not in e5.kinds(), str(e5.kinds()))
+
+        # --- the tier off: no spill call at all, 0078's shape unchanged -----------------------------------------
+        off = [Snap(ids(100), 100, 100), Snap(ids(200), 100, 100), Snap(ids(300), 100, 100)]
+        e6 = FakeEngine(off, live, cache_bytes=250, spill=False)     # the same shape as the first case
+        torch.cuda.empty_cache = lambda: e6.log.append(("empty_cache", None))
+        GlmEngine._take_over(e6, ids(400, base=9000))
+        check("take_over: with the tier off nothing spills and the drops still precede the copies",
+              not any(k.startswith("spill") for k in e6.kinds())
+              and "drop" in e6.kinds() and "save_rows" in e6.kinds(), str(e6.kinds()))
+
+        # --- a snapshot the next prompt resumes is left alone ----------------------------------------------------
+        keep_ids = ids(400)
+        res = Snap(ids(100), 100, 100)
+        e7 = FakeEngine([res], keep_ids, cache_bytes=10, spill=True)
+        torch.cuda.empty_cache = lambda: e7.log.append(("empty_cache", None))
+        GlmEngine._take_over(e7, keep_ids)
+        check("take_over: a snapshot the next prompt resumes is neither dropped nor copied",
+              not [k for k in e7.kinds() if k in ("drop", "save_rows", "spill_snap")], str(e7.kinds()))
+    finally:
+        D.row_bytes, D.save_rows, D.snapshot_bytes = saved_fns
+        torch.cuda.empty_cache = empty
+    return log
+
+
+def main():
+    print(f"spill tier checks (patch 0084) on torch {torch.__version__}, device cpu")
