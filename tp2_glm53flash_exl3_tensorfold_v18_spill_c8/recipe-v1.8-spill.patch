diff --git a/tools/spill_scripts_check.sh b/tools/spill_scripts_check.sh
new file mode 100755
index 0000000..60fc2a9
--- /dev/null
+++ b/tools/spill_scripts_check.sh
@@ -0,0 +1,180 @@
+#!/usr/bin/env bash
+# Checks for patch 0084's script integration (start.sh, stop.sh, scripts/config.sh). Run from the recipe root:
+#
+#     ./tools/spill_scripts_check.sh
+#
+# No docker, no ssh, no server: `docker` is a local mock on PATH, and the pieces of start.sh/stop.sh under test are
+# the real lines, sourced out of those files. It covers what the settings alone cannot decide:
+#
+#   enabled/disabled by the *effective* flags, not by SPILL_GIB (SPILL_GIB=0 ./start.sh --spill-gib 64 must still
+#   mount and pass the flush budget; SPILL_GIB=64 ./start.sh --spill-gib 0 must not), the refusals for a
+#   --snapshot-dir the tier cannot live in, DRY_RUN=1 changing nothing, and the stop timeout inferred from the
+#   container that is actually running (60 + 30) with an explicit STOP_TIMEOUT still winning.
+#
+# Exit code 1 when a check fails.
+set -uo pipefail
+cd "$(dirname "$(readlink -f "$0")")/.."
+ROOT=$PWD
+fails=0
+check() {   # check <name> <expected> <got>
+  if [[ "$2" == "$3" ]]; then printf 'ok   %s\n' "$1"
+  else printf 'FAIL %s (want %q, got %q)\n' "$1" "$2" "$3"; fails=$((fails + 1)); fi
+}
+contains() {  # contains <name> <needle> <haystack>
+  if [[ "$3" == *"$2"* ]]; then printf 'ok   %s\n' "$1"
+  else printf 'FAIL %s (%q not in %q)\n' "$1" "$2" "$3"; fails=$((fails + 1)); fi
+}
+lacks() {
+  if [[ "$3" != *"$2"* ]]; then printf 'ok   %s\n' "$1"
+  else printf 'FAIL %s (%q in %q)\n' "$1" "$2" "$3"; fails=$((fails + 1)); fi
+}
+
+# ---------------------------------------------------------------- the real lines under test, lifted from start.sh
+# arg_value, the effective-flag gate, and the RUN_ARGS mount block: taken from start.sh so the check cannot drift
+# from it (sed by the comment markers the file itself carries).
+GATE=$(sed -n '/^# The effective value of a flag/,/^fi$/p' start.sh)
+MOUNT=$(sed -n '/^if (( SPILL_ON )); then/,/^fi$/p' start.sh)
+TMO=$(sed -n '/^spill_stop_timeout() {/,/^}$/p' scripts/config.sh)
+[[ "$GATE" == *SPILL_GIB_EFF* && "$MOUNT" == *TF_SPILL_FLUSH_S* && "$TMO" == *Config.Cmd* ]] ||
+  { echo "FAIL could not lift the blocks out of start.sh / scripts/config.sh"; exit 1; }
+
+# one scenario: SPILL_* settings + command-line arguments -> SPILL_ON / SPILL_MOUNT / RUN_ARGS, or a die message
+scenario() {
+  local spill_gib=$1 dry=$2; shift 2
+  env -i PATH="$PATH" HOME="$HOME" ROOT="$ROOT" SPILL_GIB="$spill_gib" DRY="$dry" \
+    SPILL_DIR="${SPILL_DIR_OVERRIDE:-/host/spill}" SPILL_HIGHWATER=0.70 SPILL_MIN_TOKENS=8192 \
+    SPILL_MIN_FREE_GIB=50 SPILL_FLUSH_S=60 ARGS_EXTRA="$*" bash -s <<'EOS' 2>&1
+set -uo pipefail
+die()  { echo "DIE: $*"; exit 7; }
+log()  { echo "LOG: $*"; }
+worker_ids() { seq 1 1; }
+worker() { echo "WORKER_MUTATION rank $1: $2"; }
+mkdir() { echo "MKDIR $*"; }
+SERVE_ARGS=()
+if [[ "$SPILL_GIB" != 0 ]]; then
+  SERVE_ARGS+=(--spill-gib "$SPILL_GIB" --snapshot-dir /spill --spill-highwater "$SPILL_HIGHWATER"
+               --spill-min-tokens "$SPILL_MIN_TOKENS" --spill-min-free-gib "$SPILL_MIN_FREE_GIB")
+fi
+read -r -a _extra <<<"${ARGS_EXTRA:-}"
+(( ${#_extra[@]} )) && SERVE_ARGS+=("${_extra[@]}")
+eval "$(sed -n '/^# The effective value of a flag/,/^fi$/p' "$ROOT/start.sh")"
+RUN_ARGS=(--gpus all)
+eval "$(sed -n '/^if (( SPILL_ON )); then/,/^fi$/p' "$ROOT/start.sh")"
+echo "SPILL_ON=$SPILL_ON"
+echo "SPILL_MOUNT=$SPILL_MOUNT"
+echo "RUN_ARGS=${RUN_ARGS[*]}"
+EOS
+}
+
+echo "== blocker 1: the effective flags decide, not SPILL_GIB =="
+out=$(scenario 0 0)
+check   "settings off, no argument: the tier is off"            "SPILL_ON=0" "$(grep '^SPILL_ON=' <<<"$out")"
+lacks   "settings off: nothing is mounted"                      "-v " "$(grep '^RUN_ARGS=' <<<"$out")"
+lacks   "settings off: no flush budget is passed"               "TF_SPILL_FLUSH_S" "$out"
+
+out=$(scenario 64 0)
+check   "settings on: the tier is on"                           "SPILL_ON=1" "$(grep '^SPILL_ON=' <<<"$out")"
+contains "settings on: the directory is bound at /spill"        "-v /host/spill:/spill" "$out"
+contains "settings on: the flush budget is passed"              "-e TF_SPILL_FLUSH_S=60" "$out"
+
+out=$(scenario 0 0 --spill-gib 64 --snapshot-dir /spill)
+check   "SPILL_GIB=0 plus --spill-gib 64: the tier is on"       "SPILL_ON=1" "$(grep '^SPILL_ON=' <<<"$out")"
+contains "... and the directory is bound"                       "-v /host/spill:/spill" "$out"
+contains "... and the flush budget is passed"                   "-e TF_SPILL_FLUSH_S=60" "$out"
+
+out=$(scenario 64 0 --spill-gib 0)
+check   "SPILL_GIB=64 plus --spill-gib 0: the tier is off"      "SPILL_ON=0" "$(grep '^SPILL_ON=' <<<"$out")"
+lacks   "... and nothing is mounted"                            "-v " "$(grep '^RUN_ARGS=' <<<"$out")"
+
+out=$(scenario 64 0 --spill-gib=0)
+check   "the --flag=value form counts too"                      "SPILL_ON=0" "$(grep '^SPILL_ON=' <<<"$out")"
+
+out=$(scenario 0 0 --spill-gib 64 --snapshot-dir /elsewhere)
+contains "an absolute --snapshot-dir override is honoured"      "-v /host/spill:/elsewhere" "$out"
+
+echo
+echo "== blocker 1: unsupported overrides are refused, before anything is stopped =="
+out=$(scenario 0 0 --spill-gib 64 --snapshot-dir none)
+contains "--snapshot-dir none is refused"                       "DIE: --snapshot-dir none" "$out"
+out=$(scenario 0 0 --spill-gib 64 --snapshot-dir rel/ative)
+contains "a relative --snapshot-dir is refused"                 "DIE: --snapshot-dir must be an absolute path" "$out"
+out=$(scenario 0 0 --spill-gib 64)
+contains "--spill-gib without --snapshot-dir is refused"        "DIE: --spill-gib 64 needs --snapshot-dir" "$out"
+out=$(SPILL_DIR_OVERRIDE=rel/ative scenario 64 0)
+contains "a relative SPILL_DIR is refused"                      "DIE: SPILL_DIR must be an absolute path" "$out"
+for o in "$(scenario 0 0 --spill-gib 64 --snapshot-dir none)" "$(SPILL_DIR_OVERRIDE=rel scenario 64 0)"; do
+  lacks "a refusal mounts nothing"                              "-v " "$(grep '^RUN_ARGS=' <<<"$o")"
+done
+
+echo
+echo "== blocker 2: DRY_RUN=1 mutates nothing =="
+out=$(scenario 64 1)
+contains "DRY_RUN prints the plan"                              "LOG: DRY_RUN: would create /host/spill" "$out"
+lacks   "DRY_RUN does not mkdir here"                           "MKDIR" "$out"
+lacks   "DRY_RUN does not touch a worker over ssh"              "WORKER_MUTATION" "$out"
+contains "DRY_RUN still shows the mount it would use"           "-v /host/spill:/spill" "$out"
+out=$(scenario 64 0)
+contains "without DRY_RUN the directory is created here"        "MKDIR -p /host/spill" "$out"
+contains "without DRY_RUN the worker's is created too"          "WORKER_MUTATION rank 1" "$out"
+
+echo
+echo "== blocker 3 / lifecycle: the stop timeout follows the running container =="
+MOCK=$(mktemp -d)
+trap 'rm -rf "$MOCK"' EXIT
+cat > "$MOCK/docker" <<'EOS'
+#!/usr/bin/env bash
+# a read-only mock of `docker inspect -f <fmt> <name>`: the container's Cmd and Env come from the environment
+[[ "${1:-}" == inspect ]] || { echo "mock docker: only inspect" >&2; exit 2; }
+fmt=""; for a in "$@"; do [[ -n "${want:-}" ]] && { fmt=$a; want=; }; [[ "$a" == -f ]] && want=1; done
+[[ "${MOCK_PRESENT:-1}" == 1 ]] || { echo "Error: No such object" >&2; exit 1; }
+case "$fmt" in
+  *.Config.Cmd*) printf '%s\n' ${MOCK_CMD:-} ;;
+  *.Config.Env*) printf '%s\n' ${MOCK_ENV:-} ;;
+  *State.Running*) echo "${MOCK_RUNNING:-true}" ;;
+esac
+EOS
+chmod +x "$MOCK/docker"
+
+timeout_for() {  # timeout_for <explicit STOP_TIMEOUT or ""> <SPILL_GIB> <MOCK_CMD> <MOCK_ENV> [MOCK_PRESENT]
+  local e=$1; shift
+  env -i PATH="$MOCK:$PATH" HOME="$HOME" ROOT="$ROOT" SPILL_GIB="$1" MOCK_CMD="$2" MOCK_ENV="$3" \
+    MOCK_PRESENT="${4:-1}" ${e:+STOP_TIMEOUT="$e"} bash -s <<'EOS' 2>&1
+set -uo pipefail
+CONTAINER_NAME=tf-check
+SPILL_DIR=/host/spill; SPILL_HIGHWATER=0.70; SPILL_MIN_TOKENS=8192; SPILL_MIN_FREE_GIB=50; SPILL_FLUSH_S=60
+STOP_TIMEOUT_EXPLICIT=${STOP_TIMEOUT+1}
+if [[ "$SPILL_GIB" != 0 ]]; then STOP_TIMEOUT="${STOP_TIMEOUT:-$(( ${SPILL_FLUSH_S%.*} + 30 ))}"; fi
+eval "$(sed -n '/^spill_stop_timeout() {/,/^}$/p' "$ROOT/scripts/config.sh")"
+spill_stop_timeout
+EOS
+}
+CMD_ON="tensorfold serve /m --spill-gib 64 --snapshot-dir /spill"
+CMD_OFF="tensorfold serve /m --parallel 4"
+check "ephemeral start, plain stop: the flush budget is inferred (60+30)" "90" \
+      "$(timeout_for "" 0 "$CMD_ON" "TF_SPILL_FLUSH_S=60")"
+check "a longer flush in the container is honoured (120+30)"              "150" \
+      "$(timeout_for "" 0 "$CMD_ON" "TF_SPILL_FLUSH_S=120")"
+check "no TF_SPILL_FLUSH_S in the container: 60 is assumed"               "90" \
+      "$(timeout_for "" 0 "$CMD_ON" "")"
+check "the tier off in the container: the default 30 stands"              "30" \
+      "$(timeout_for "" 0 "$CMD_OFF" "")"
+check "--spill-gib 0 in the container: the default 30 stands"             "30" \
+      "$(timeout_for "" 0 "tensorfold serve /m --spill-gib 0" "")"
+check "--spill-gib=64 in the container counts too"                        "90" \
+      "$(timeout_for "" 0 "tensorfold serve /m --spill-gib=64" "TF_SPILL_FLUSH_S=60")"
+check "no container here: the configured value stands"                    "30" \
+      "$(timeout_for "" 0 "$CMD_ON" "TF_SPILL_FLUSH_S=60" 0)"
+check "an explicit STOP_TIMEOUT wins over the inference"                  "45" \
+      "$(timeout_for 45 0 "$CMD_ON" "TF_SPILL_FLUSH_S=60")"
+check "an explicit STOP_TIMEOUT wins with the settings on too"            "15" \
+      "$(timeout_for 15 64 "$CMD_ON" "TF_SPILL_FLUSH_S=60")"
+check "settings on, no container: config.sh's own value stands"           "90" \
+      "$(timeout_for "" 64 "$CMD_ON" "TF_SPILL_FLUSH_S=60" 0)"
+# settings on (config.sh's base is SPILL_FLUSH_S 60 + 30 = 90) but the running container asks for only 10 + 30:
+# the inference raises, never lowers
+check "a larger configured value is never lowered"                        "90" \
+      "$(timeout_for "" 64 "$CMD_ON" "TF_SPILL_FLUSH_S=10")"
+
+echo
+if (( fails )); then echo "$fails check(s) failed"; exit 1; fi
+echo "all passed"
