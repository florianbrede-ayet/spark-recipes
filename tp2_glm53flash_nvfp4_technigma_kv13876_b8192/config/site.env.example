# Copy to config/site.env and replace every <PLACEHOLDER> with a value read off
# YOUR nodes. tools/envmerge.py refuses to emit an environment while any
# <...> token survives, so an unedited copy cannot start a service.
#
# The same file is used on both nodes: it carries both fabric addresses, and
# the launcher picks the local one from --role. Keep the two copies identical.
#
# Nothing here changes the recipe profile (config/profile.env). These are the
# eight keys the pinned upstream compose files need from the local machine.

# --- RoCE fabric -------------------------------------------------------------
# IPv4 addresses of the single RoCE port used by this recipe, one per node.
# MASTER_ADDR must equal HEAD_ROCE_IP; the merge refuses otherwise.
HEAD_ROCE_IP=<HEAD_FABRIC_IP>
WORKER_ROCE_IP=<WORKER_FABRIC_IP>
MASTER_ADDR=<HEAD_FABRIC_IP>

# --- interfaces --------------------------------------------------------------
# One RDMA device and one netdev. Both GB10 ports are twins across two
# different /30s, and the GID-probe loop in the upstream compose command walks
# every device in NCCL_IB_HCA and keeps the first RoCEv2 IPv4 GID it finds, so
# listing both twins can bind the wrong port. This recipe therefore pins a
# single device: the merge rejects a comma-separated list.
#   ibv_devinfo -l                     # RDMA device names
#   ls /sys/class/infiniband/<dev>/device/net   # its netdev
NCCL_IB_HCA=<ROCE_RDMA_DEVICE>
NCCL_SOCKET_IFNAME=<ROCE_NETDEV>
# Control netdev for the Gloo/TP/OOB rendezvous. Same netdev as above on a
# single-fabric node.
CONTROL_IF=<CONTROL_NETDEV>

# --- host paths and groups ---------------------------------------------------
# Absolute path to the Hugging Face cache that already holds the pinned model
# revision. Validation never downloads weights - see README "Model cache".
HF_CACHE=<ABSOLUTE_HF_CACHE_DIR>
# Numeric group owning the DRM render node, required by the upstream
# display-KV override:
#   stat -c '%g %G' /dev/dri/card0
DRM_CARD_GID=<DRM_CARD_GID>
