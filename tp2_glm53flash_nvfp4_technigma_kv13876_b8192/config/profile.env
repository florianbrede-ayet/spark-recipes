# Recipe profile constants - GLM-5.3-Flash NVFP4 (technigmaai R28.8-A) on two
# DGX Spark / GB10 nodes, tensor-parallel 2.
#
# These are the values this recipe *is*. Every key below differs from the
# pinned upstream .env.example (see README "Environment delta"); every other
# key in the merged environment comes from that upstream file unchanged.
#
# Site-specific values (fabric addresses, interface names, cache path, DRM
# group) are NOT here - they live in config/site.env, from site.env.example.
# Editing a site value therefore cannot change the recipe.
#
# Both tools/envmerge.py (every merge) and launch.sh (before it merges, renders
# or starts anything) match this file and compose.phase1.override.yaml against
# their entries in the published SHA256SUMS, so a valid-looking edit to a digest,
# revision or capacity value is refused. That is a drift guard against local
# edits, not an authenticity proof.

# --- image -------------------------------------------------------------------
# Digest pin, not the mutable R28.8-A release tag that upstream's example uses.
# The tag can be repointed at a rebuild; the digest cannot.
IMAGE=technigmaai/glm-5.3-flash-nvfp4-2x-dgx-sparks@sha256:1169f797539454e3c286557d49fddd488488957d9a3f10638b01052998370622

# --- model -------------------------------------------------------------------
# Spark-specific checkpoint and revision, pinned identically on both nodes.
MODEL_PATH=local-inference-lab/GLM-5.3-Flash-NVFP4-Spark
MODEL_REVISION=a608241037e4c2565356bff7ca293f2133888f88
# Single served-model id. The upstream example publishes two aliases; the
# compose serve line expands this value unquoted, so one token means one
# --served-model-name argument.
SERVED_MODEL_NAME=local-inference-lab/GLM-5.3-Flash-NVFP4-Spark

# --- API ---------------------------------------------------------------------
# Rank 0 listens on 0.0.0.0:8888. Unauthenticated - see README "Exposure".
PORT=8888

# --- capacity / scheduling ---------------------------------------------------
# 13,876 MiB of KV per rank (the "M" suffix is MiB, not MB).
KV_CACHE_MEMORY_BYTES=13876M
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
# 4096-token split pages, chosen for mixed prefill/decode overlap.
GLM53_SPLIT_TARGET_BLOCK_SIZE=4096

# --- Phase 1 peer-wait mitigation -------------------------------------------
# Key absent from the upstream example. It reaches the container only through
# this recipe's compose.phase1.override.yaml.
B12X_ROCE_SPIN_LIMIT=200000000

# --- discarded upstream SSH-helper keys -------------------------------------
# No compose file reads these; only upstream's start.sh does, and this
# recipe's launcher never uses SSH. Blanked so that no worker hostname, login
# or directory layout can reach the emitted env file.
WORKER_DIR=
WORKER_SSH_TARGET=
WORKER_ROCE_SSH_TARGET=
